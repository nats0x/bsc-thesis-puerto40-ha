SUBSYSTEM!="block", GOTO="asm_fin"
KERNEL!="sd?", GOTO="asm_fin"
ENV{ID_SCSI_SERIAL}=="asm-ocr1", SYMLINK+="oracleasm/asm-ocr1", GOTO="asm_permisos"
ENV{ID_SCSI_SERIAL}=="asm-data1", SYMLINK+="oracleasm/asm-data1", GOTO="asm_permisos"
ENV{ID_SCSI_SERIAL}=="asm-fra1", SYMLINK+="oracleasm/asm-fra1", GOTO="asm_permisos"
GOTO="asm_fin"
LABEL="asm_permisos"
OWNER="grid", GROUP="asmadmin", MODE="0660"
LABEL="asm_fin"
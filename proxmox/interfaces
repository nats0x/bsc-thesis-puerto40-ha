auto vmbr1
iface vmbr1 inet static
    address 10.0.0.1/24
    bridge-ports none
    bridge-stp off
    bridge-fd 0
    post-up   iptables -t nat -A POSTROUTING -s 10.0.0.0/24 -o <interfaz pública> -j MASQUERADE
    post-down iptables -t nat -D POSTROUTING -s 10.0.0.0/24 -o <interfaz pública> -j MASQUERADE
auto vmbr10
iface vmbr10 inet static
    address 10.40.10.254/24
    bridge-ports none
    bridge-stp off
    bridge-fd 0
    post-up   ip route add 10.40.0.0/16 via 10.40.10.1
    post-down ip route del 10.40.0.0/16 via 10.40.10.1
    post-up   iptables -t nat -A POSTROUTING -s 10.40.0.0/16 -o <interfaz pública> -j MASQUERADE
    post-down iptables -t nat -D POSTROUTING -s 10.40.0.0/16 -o <interfaz pública> -j MASQUERADE
#VLAN 10 gestión
auto vmbr110
iface vmbr110 inet static
    address 10.40.110.1/24
    bridge-ports none
    bridge-stp off
    bridge-fd 0
    post-up   sysctl -w net.ipv4.conf.vmbr110.forwarding=1
    post-up   iptables -t nat -A POSTROUTING -s 10.40.110.0/24 -o <interfaz pública> -j MASQUERADE
    post-down iptables -t nat -D POSTROUTING -s 10.40.110.0/24 -o <interfaz pública> -j MASQUERADE
